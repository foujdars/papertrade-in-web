NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://papertrade.site

# Required only by the server-side account deletion route. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Keep broker secrets server-side. Never prefix them with NEXT_PUBLIC_.
UPSTOX_ACCESS_TOKEN=YOUR_UPSTOX_TOKEN

# Optional GMP enrichment for open IPOs. Keep this server-side and never use a NEXT_PUBLIC_ prefix.
IPOALERTS_API_KEY=YOUR_IPOALERTS_API_KEY

# Independent global reference charts. Keep all credentials server-side.
# US shares and ETFs (Alpaca IEX)
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
# US listing backup and primary XAU/USD feed (commodities access required for gold)
TWELVE_DATA_API_KEY=
# XAU/USD backup (OANDA practice account with XAU_USD access)
OANDA_DATA_TOKEN=
